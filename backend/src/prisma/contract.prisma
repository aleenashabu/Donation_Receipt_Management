
enum DonationStatus {
  RECEIVED
  PENDING
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CHEQUE
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Donor {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  phone       String
  address     String
  city        String
  province    String
  postalCode  String
  country     String
  isActive    Boolean  @default(true)
  donations   Donation[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Fund {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  isActive    Boolean  @default(true)
  donations   Donation[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Donation {
  id              Int            @id @default(autoincrement())
  donor           Donor          @relation(fields: [donorId], references: [id], onDelete: Restrict)
  donorId         Int
  fund            Fund           @relation(fields: [fundId], references: [id], onDelete: Restrict)
  fundId          Int
  donationDate    TimestamptzString @default(now())
  amount          Numeric
  currency        String         @default("CAD")
  paymentMethod   PaymentMethod
  referenceNumber String
  purpose         String
  notes           String
  status          DonationStatus @default(PENDING)
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}
